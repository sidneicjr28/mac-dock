post_install() {
    cat <<'MSG'
==> Mac Dock starts on your next Plasma login, or now with: mac-dock -d
==> Settings: right-click the dock. They are saved in ~/.config/mac-dock/.
==> Installed earlier with install.sh? Remove its autostart entry so only one dock starts:
      rm ~/.config/autostart/mac-dock.desktop
==> Glass blur (optional): install kwin-effects-glass-git, then run
      kwriteconfig6 --file kwinrc --group Plugins --key glassEnabled true
      kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled false
      kwriteconfig6 --file kwinrc --group Effect-blurplus --key WindowClasses quickshell
    and log out and back in.
MSG
}

post_upgrade() {
    echo "==> Restart the dock to use the new version: qs kill -p /usr/share/mac-dock; mac-dock -d"
}
