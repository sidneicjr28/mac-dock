pkgname=mac-dock-git
_pkgname=mac-dock
pkgver=0.2.0.r0.g0000000
pkgrel=1
pkgdesc="macOS-style glass dock for KDE Plasma 6 (Wayland), built with Quickshell"
arch=('any')
url="https://github.com/sidneicjr28/mac-dock"
license=('MIT')
depends=('quickshell' 'python' 'python-pywayland' 'python-dbus' 'python-gobject' 'kwin' 'kconfig' 'qt6-tools')
makedepends=('git')
optdepends=('kwin-effects-glass-git: Glass background blur (otherwise KDE Blur is used)')
provides=("$_pkgname")
conflicts=("$_pkgname")
install=mac-dock.install
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

package() {
    cd "$_pkgname"
    install -d "$pkgdir/usr/share/$_pkgname"
    cp -r --no-preserve=ownership shell.qml dock glass services settings bridge "$pkgdir/usr/share/$_pkgname/"
    find "$pkgdir/usr/share/$_pkgname" -name __pycache__ -prune -exec rm -rf {} +
    install -Dm755 packaging/mac-dock -t "$pkgdir/usr/bin"
    install -Dm644 packaging/mac-dock.desktop -t "$pkgdir/usr/share/applications"
    install -Dm644 packaging/mac-dock.desktop -t "$pkgdir/etc/xdg/autostart"
    install -Dm644 docs/logo.png "$pkgdir/usr/share/pixmaps/$_pkgname.png"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
